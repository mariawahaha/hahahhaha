section .data
    prompt db "Enter value: "
    prompt_len equ $ - prompt

    choice_msg db "m = minutes, s = seconds: "
    choice_len equ $ - choice_msg

    timesup db 10, "Time's up!", 10
    timesup_len equ $ - timesup

    beep db 7

    ; 1 second sleep
    ts:
        dq 1
        dq 0

    ; short delay for alarm
    ts_short:
        dq 0
        dq 300000000

section .bss
    input resb 16
    choice resb 2
    buffer resb 8   ; "MM:SS\r"

section .text
    global _start

_start:

    ; ---- INPUT VALUE ----
    mov rax, 1
    mov rdi, 1
    mov rsi, prompt
    mov rdx, prompt_len
    syscall

    mov rax, 0
    mov rdi, 0
    mov rsi, input
    mov rdx, 16
    syscall

    mov byte [input + rax - 1], 0

    ; ---- INPUT TYPE ----
    mov rax, 1
    mov rdi, 1
    mov rsi, choice_msg
    mov rdx, choice_len
    syscall

    mov rax, 0
    mov rdi, 0
    mov rsi, choice
    mov rdx, 2
    syscall

    ; ---- CONVERT INPUT ----
    mov rsi, input
    call atoi
    mov rbx, rax

    ; convert minutes → seconds
    mov al, [choice]
    cmp al, 'm'
    jne .skip
    imul rbx, 60
.skip:

    cmp rbx, 0
    jle done

; -------------------------
timer_loop:

    ; calculate MM:SS
    mov rax, rbx
    xor rdx, rdx
    mov rcx, 60
    div rcx

    mov r8, rax    ; minutes
    mov r9, rdx    ; seconds

    ; ---- FORMAT MM ----
    mov rax, r8
    mov rcx, 10
    xor rdx, rdx
    div rcx
    add al, '0'
    mov [buffer], al
    add dl, '0'
    mov [buffer+1], dl

    mov byte [buffer+2], ':'

    ; ---- FORMAT SS ----
    mov rax, r9
    mov rcx, 10
    xor rdx, rdx
    div rcx
    add al, '0'
    mov [buffer+3], al
    add dl, '0'
    mov [buffer+4], dl

    mov byte [buffer+5], 13   ; carriage return (\r)

    ; print (overwrite same line)
    mov rax, 1
    mov rdi, 1
    mov rsi, buffer
    mov rdx, 6
    syscall

    ; sleep 1 sec
    mov rax, 35
    mov rdi, ts
    xor rsi, rsi
    syscall

    dec rbx
    jmp timer_loop

; -------------------------
done:

    ; move to next line
    mov byte [buffer], 10
    mov rax, 1
    mov rdi, 1
    mov rsi, buffer
    mov rdx, 1
    syscall

    ; show message
    mov rax, 1
    mov rdi, 1
    mov rsi, timesup
    mov rdx, timesup_len
    syscall

    ; 🔔 strong alarm (infinite until stopped)
alarm_loop:
    mov rax, 1
    mov rdi, 1
    mov rsi, beep
    mov rdx, 1
    syscall

    mov rax, 35
    mov rdi, ts_short
    xor rsi, rsi
    syscall

    jmp alarm_loop

; -------------------------
; atoi
atoi:
    xor rax, rax
.next:
    movzx rcx, byte [rsi]
    cmp rcx, 0
    je .done
    cmp rcx, '0'
    jb .done
    cmp rcx, '9'
    ja .done

    sub rcx, '0'
    imul rax, 10
    add rax, rcx

    inc rsi
    jmp .next
.done:
    ret
