section .data
    prompt_min db "Enter minutes: "
    len_min equ $ - prompt_min

    prompt_sec db "Enter seconds: "
    len_sec equ $ - prompt_sec

    colon db ":"
    newline db 10

    timesup db 10, "Time's up!", 10
    len_timesup equ $ - timesup

    beep db 7

    ts: dq 1, 0                 ; 1 second
    ts_short: dq 0, 200000000   ; 0.2 sec

section .bss
    min_in resb 16
    sec_in resb 16
    buffer resb 6               ; MM:SS

section .text
    global _start

_start:

; -------- INPUT MINUTES --------
    mov rax, 1
    mov rdi, 1
    mov rsi, prompt_min
    mov rdx, len_min
    syscall

    mov rax, 0
    mov rdi, 0
    mov rsi, min_in
    mov rdx, 16
    syscall

    mov byte [min_in + rax - 1], 0

; -------- INPUT SECONDS --------
    mov rax, 1
    mov rdi, 1
    mov rsi, prompt_sec
    mov rdx, len_sec
    syscall

    mov rax, 0
    mov rdi, 0
    mov rsi, sec_in
    mov rdx, 16
    syscall

    mov byte [sec_in + rax - 1], 0

; -------- CONVERT --------
    mov rsi, min_in
    call atoi
    mov rbx, rax        ; minutes

    mov rsi, sec_in
    call atoi
    mov rcx, rax        ; seconds

    imul rbx, 60
    add rbx, rcx        ; total seconds

    cmp rbx, 0
    jle done

; -------------------------
countdown:

    mov rax, rbx
    xor rdx, rdx
    mov rcx, 60
    div rcx

    mov r8, rax     ; minutes
    mov r9, rdx     ; seconds

; ---- FORMAT MM ----
    mov rax, r8
    mov rcx, 10
    xor rdx, rdx
    div rcx
    add al, '0'
    mov [buffer], al
    add dl, '0'
    mov [buffer+1], dl

    mov byte [buffer+2], ':'

; ---- FORMAT SS ----
    mov rax, r9
    mov rcx, 10
    xor rdx, rdx
    div rcx
    add al, '0'
    mov [buffer+3], al
    add dl, '0'
    mov [buffer+4], dl

    mov byte [buffer+5], 10

; ---- PRINT ----
    mov rax, 1
    mov rdi, 1
    mov rsi, buffer
    mov rdx, 6
    syscall

; ---- WAIT ----
    mov rax, 35
    mov rdi, ts
    xor rsi, rsi
    syscall

    dec rbx
    jnz countdown

; -------------------------
done:

; ---- MESSAGE ----
    mov rax, 1
    mov rdi, 1
    mov rsi, timesup
    mov rdx, len_timesup
    syscall

; ---- STRONG ALARM ----
    mov rcx, 20        ; more beeps = louder/longer
alarm:
    mov rax, 1
    mov rdi, 1
    mov rsi, beep
    mov rdx, 1
    syscall

    mov rax, 35
    mov rdi, ts_short
    xor rsi, rsi
    syscall

    loop alarm

; ---- EXIT ----
    mov rax, 60
    xor rdi, rdi
    syscall

; -------------------------
; ASCII → INTEGER (MULTI-DIGIT)
atoi:
    xor rax, rax
.next:
    movzx rcx, byte [rsi]
    cmp rcx, 0
    je .done
    cmp rcx, '0'
    jb .done
    cmp rcx, '9'
    ja .done

    sub rcx, '0'
    imul rax, 10
    add rax, rcx

    inc rsi
    jmp .next
.done:
    ret
