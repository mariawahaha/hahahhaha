section .data
    prompt      db "Enter total seconds: ", 0
    prompt_len  equ $ - prompt
    colon       db ":"
    newline     db 10
    timesup     db 7, "Time's up!", 10
    timesup_len equ $ - timesup

    ; --- paplay command ---
    cmd_play   db "/usr/bin/paplay",0
    arg1_play  db "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga",0
    argv_play  dq cmd_play, arg1_play, 0
    envp_play  dq 0

    ; --- Time structure ---
    timespec:
        dq 1
        dq 0

section .bss
    input resb 10

section .text
    global _start

_start:
    ; --- Print Prompt ---
    mov rax, 1
    mov rdi, 1
    mov rsi, prompt
    mov rdx, prompt_len
    syscall

    ; --- Read Input ---
    mov rax, 0
    mov rdi, 0
    mov rsi, input
    mov rdx, 10
    syscall

    ; --- Convert ASCII to Integer ---
    xor r12, r12
    xor rcx, rcx

.conv:
    movzx rax, byte [input + rcx]
    cmp al, 10
    je .main
    sub al, '0'
    imul r12, 10
    add r12, rax
    inc rcx
    jmp .conv

.main:
    cmp r12, 0
    jle .done

.timer_loop:
    ; --- Convert to MM:SS ---
    mov rax, r12
    xor rdx, rdx
    mov rbx, 60
    div rbx

    push rdx
    call print_number

    ; --- Print colon ---
    mov rax, 1
    mov rdi, 1
    mov rsi, colon
    mov rdx, 1
    syscall

    ; --- Print seconds ---
    pop r13
    cmp r13, 10
    jge .no_zero
    push '0'
    mov rax, 1
    mov rdi, 1
    mov rsi, rsp
    mov rdx, 1
    syscall
    pop rax

.no_zero:
    mov rax, r13
    call print_number

    ; newline
    mov rax, 1
    mov rdi, 1
    mov rsi, newline
    mov rdx, 1
    syscall

    ; sleep 1 sec
    mov rax, 35
    mov rdi, timespec
    xor rsi, rsi
    syscall

    dec r12
    jnz .timer_loop

.done:
    ; --- Print Time's up ---
    mov rax, 1
    mov rdi, 1
    mov rsi, timesup
    mov rdx, timesup_len
    syscall

    ; --- PLAY SOUND (5 times) ---
    mov rcx, 5
.play_loop:
    mov rax, 59
    mov rdi, cmd_play
    mov rsi, argv_play
    mov rdx, envp_play
    syscall
    loop .play_loop

    ; exit
    mov rax, 60
    xor rdi, rdi
    syscall


; -------- PRINT NUMBER --------
print_number:
    test rax, rax
    jnz .work

    push '0'
    mov rax, 1
    mov rdi, 1
    mov rsi, rsp
    mov rdx, 1
    syscall
    pop rax
    ret

.work:
    mov rbx, 10
    xor r14, r14

.push:
    xor rdx, rdx
    div rbx
    add dl, '0'
    push rdx
    inc r14
    test rax, rax
    jnz .push

.pop:
    mov rax, 1
    mov rdi, 1
    mov rsi, rsp
    mov rdx, 1
    syscall
    pop rax
    dec r14
    jnz .pop
    ret
